<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen, touch-swallowing overlay shown by SearchLaunchGuard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="false"
    android:soundEffectsEnabled="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/search_launch_guard_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            tools:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/search_launch_guard_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            tools:text="Opening Telegram" />

        <de.jrpie.android.launcher.ui.list.apps.LaunchGuardProgressView
            android:id="@+id/search_launch_guard_progress"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</FrameLayout>
